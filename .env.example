# Copy to .env and adjust. All values are optional.

# Where Ollama listens
OLLAMA_HOST=http://127.0.0.1:11434

# Model to chat with (keep it small for fast local replies)
OLLAMA_MODEL=smollm:135m

# Server bind address
HOST=127.0.0.1
PORT=8080

# How long to wait for a reply from Ollama, in seconds
OLLAMA_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=5

# Conversation memory sent to the model
CONTEXT_MESSAGES=12
CONTEXT_CHAR_BUDGET=6000

# Cap on reply length
MAX_REPLY_TOKENS=220

# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
